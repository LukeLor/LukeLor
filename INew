local ControllerManager = entity.ControllerManager
local function Move(node:Part)
	local path = game:GetService("PathfindingService"):FindPathAsync(entity.Root.Position,node.Position)
	local oldnodepos = node.Position
	repeat task.wait()

		for _, waypoint in path:GetWaypoints() do
			ControllerManager.MovingDirection = (waypoint.Position-entity.Root.Position).Unit
			ControllerManager.FacingDirection = (waypoint.Position-entity.Root.Position).Unit

		end
		if node.Position ~= oldnodepos  then
			--print("changed pos to: "..tostring(node.Position))
			path = game:GetService("PathfindingService"):FindPathAsync(entity.Root.Position,node.Position)

			oldnodepos = node.Position
			for _, waypoint in path:GetWaypoints() do
				ControllerManager.MovingDirection = (waypoint.Position-entity.Root.Position).Unit
				ControllerManager.FacingDirection = (waypoint.Position-entity.Root.Position).Unit
				for _, waypoint in path:GetWaypoints() do
					local rp = Instance.new("Part")
					rp.Parent = folder
					rp.Anchored = true
					rp.Position = waypoint.Position
					rp.Size = Vector3.new(1,1,1)
					--print("Made")
					rp.CanCollide = false

					rp.Color = Color3.new(1, 0, 0)

				end
				repeat task.wait()
					if node.Position ~= oldnodepos  then
						break
					end


				until(entity.Root.Position - waypoint.Position).Magnitude <= 7   

			end
			--	break
		end

	until (entity.Root.Position - node.Position).Magnitude <= 7 
end
